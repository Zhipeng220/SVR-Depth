+class DataRootTests(unittest.TestCase):
+    def test_dataroot_matches_and_conflicts(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            a, b = Path(tmp) / "a", Path(tmp) / "b"
+            a.mkdir(); b.mkdir()
+            root, env = checked_environment(a, {})
+            self.assertEqual(env["DATAROOT"], str(root))
+            self.assertEqual(checked_environment(a, {"DATAROOT": str(a)})[0], root)
+            with self.assertRaisesRegex(ValueError, "conflicts"):
+                checked_environment(a, {"DATAROOT": str(b)})
+            with self.assertRaises(FileNotFoundError):
+                checked_environment(Path(tmp) / "missing", {})
+
+    def test_launcher_passes_checked_root_to_upstream_process(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            repo, data, other = root / "repo", root / "data", root / "other"
+            (repo / "scripts").mkdir(parents=True)
+            (repo / "velodepth" / "datasets").mkdir(parents=True)
+            (repo / "velodepth" / "datasets" / "base_dataset.py").write_text("")
+            data.mkdir(); other.mkdir()
+            (repo / "scripts" / "eval.py").write_text(
+                "import argparse, json, os\n"
+                "p=argparse.ArgumentParser(); p.add_argument('--dataroot', required=True); "
+                "p.add_argument('--tag'); a=p.parse_args()\n"
+                "print('EVIDENCE='+json.dumps([a.dataroot,os.environ['DATAROOT'],a.tag,os.getcwd()]))\n"
+            )
+            launcher = Path(__file__).with_name("official_eval_entry.py")
+            command = [sys.executable, str(launcher), "--official-repo", str(repo),
+                       "--dataroot", str(data), "--tag", "synthetic"]
+            env = os.environ.copy()
+            env.pop("DATAROOT", None)
+            result = subprocess.run(command, text=True, capture_output=True, env=env, check=True)
+            line = next(line for line in result.stdout.splitlines() if line.startswith("EVIDENCE="))
+            self.assertEqual(json.loads(line[len("EVIDENCE="):]),
+                             [str(data.resolve()), str(data.resolve()), "synthetic", str(repo.resolve())])
+            env["DATAROOT"] = str(other)
+            rejected = subprocess.run(command, text=True, capture_output=True, env=env)
+            self.assertNotEqual(rejected.returncode, 0)
+            self.assertNotIn("EVIDENCE=", rejected.stdout)
